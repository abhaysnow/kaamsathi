# ---- Backend (copy to backend/.env) ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:3000
# Leave empty to use the in-memory store (data lost on restart; fine for demo)
MONGODB_URI=
# Leave empty to use the clearly-labelled MOCK AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
# Long random string (>=32 chars) used to sign session cookies. REQUIRED in production.
SESSION_SECRET=
# Set true only when frontend and backend are served over HTTPS
COOKIE_SECURE=false
# Demo environment banner/guard; production deploys must keep a real session secret
ALLOW_DEMO_MODE=true

# ---- Frontend (copy to frontend/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
