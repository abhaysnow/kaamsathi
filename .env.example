# ---- Backend (copy to backend/.env) ----
NODE_ENV=development
PORT=4000
# Reverse proxies in front of the API (default 1 in production). Vercel behind the frontend proxy: 2
TRUST_PROXY_HOPS=
# Comma-separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:3000
# Leave empty to use the in-memory store (data lost on restart; fine for demo)
MONGODB_URI=
# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty for the clearly-labelled MOCK AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
# Long random string (>=32 chars) used to sign session cookies. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set true only when frontend and backend are served over HTTPS (REQUIRED in production)
COOKIE_SECURE=false
# Session lifetime without / with "Keep me signed in"
SESSION_TTL_HOURS=12
REMEMBER_ME_DAYS=30

# ---- Demo account (public demonstration credentials, fictional data) ----
# Default: enabled in development, DISABLED in production unless you set this to true.
DEMO_ACCOUNT_ENABLED=
DEMO_ACCOUNT_EMAIL=demo@workwise.ai
DEMO_ACCOUNT_PASSWORD=WorkerDemo@2026

# ---- Password reset email ----
# Empty in development = local "dev outbox" (GET /api/v1/dev/outbox). Empty in production =
# password reset reports that email is not configured (it never pretends to send).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
# Base URL used in reset links (defaults to the first FRONTEND_ORIGINS entry)
APP_BASE_URL=
RESET_TOKEN_TTL_MINUTES=30

# ---- Rate limits (per 15 minutes; register is per hour) ----
LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT=5
REGISTER_RATE_LIMIT=10

# ---- Frontend (copy to frontend/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Vercel: set NEXT_PUBLIC_API_BASE_URL=/api/v1 and BACKEND_URL=https://<api-project>.vercel.app
BACKEND_URL=
